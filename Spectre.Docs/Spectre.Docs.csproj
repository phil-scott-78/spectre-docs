<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Pennington models content as C# type unions (Discovered/Parsed/Rendered/Failed),
         which require the preview language version to pattern-match. -->
    <LangVersion>preview</LangVersion>
  </PropertyGroup>
  <ItemGroup>
    <Watch Include="Content\**\*.*" />
    <Watch Include="..\Spectre.Docs.Examples\**.cs" />
    <Watch Include="..\Spectre.Docs.Cli.Examples\**.cs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="MonorailCss" Version="0.0.5-alpha.0.165" />
    <PackageReference Include="MonorailCss.Discovery" Version="0.0.5-alpha.0.165" />
    <PackageReference Include="Pennington" Version="0.1.0-alpha.0.282" />
    <PackageReference Include="Pennington.ApiMetadata.Reflection" Version="0.1.0-alpha.0.282" />
    <PackageReference Include="Pennington.MonorailCss" Version="0.1.0-alpha.0.282" />
    <PackageReference Include="Pennington.UI" Version="0.1.0-alpha.0.282" />
    <PackageReference Include="Pennington.TreeSitter" Version="0.1.0-alpha.0.282" />
    <PackageReference Include="SixLabors.ImageSharp" Version="3.1.12" />
    <PackageReference Include="Spectre.Console" Version="0.55.3-alpha.0.18" />
    <PackageReference Include="Spectre.Console.Cli" Version="1.0.0-alpha.0.11" />
    <PackageReference Include="Spectre.Console.ImageSharp" Version="0.55.3-alpha.0.18" />
    <PackageReference Include="Spectre.Console.Json" Version="0.55.3-alpha.0.18" />
  </ItemGroup>
</Project>