@* Parameter table for a member card. Markup matches the original WidgetApiReference. *@
@if (Parameters.Count > 0)
{
    <div class="mt-4">
        <p class="text-xs font-semibold text-base-700 dark:text-base-300 mb-1">Parameters:</p>
        <div class="grid grid-cols-1 lg:grid-cols-[33%_1fr] gap-x-4 gap-y-2">
            @foreach (var param in Parameters)
            {
                <div class="text-xs text-base-600 dark:text-base-400">
                    <code class="text-primary-600 dark:text-primary-500 rounded">@param.Name</code>
                    @if (!string.IsNullOrEmpty(param.Type))
                    {
                        <span class="text-base-500 dark:text-base-500"> (@param.Type)</span>
                    }
                </div>
                <div class="text-xs text-base-600 dark:text-base-400">
                    @if (!string.IsNullOrEmpty(param.DescriptionHtml))
                    {
                        @((MarkupString)param.DescriptionHtml)
                    }
                </div>
            }
        </div>
    </div>
}

@code {
    [Parameter, EditorRequired] public required IReadOnlyList<ApiParamView> Parameters { get; set; }
}
